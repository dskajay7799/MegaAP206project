# Copy to .env and fill in values. Never commit .env.
SECRET_KEY=change-me-at-least-32-random-characters
APP_ENV=development

# Database — leave blank to use SQLite at instance/verity.db
DATABASE_URL=

# Demo store
ALLOW_DEV_DATA=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_DEMO=1
DEMO_PASSWORD=

# Optional: Groq AI rewriting (grounded mode works without it)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Production only
CORS_ORIGINS=https://your-site.netlify.app
PUBLIC_URL=https://your-api.onrender.com
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax
DEV_SHOW_RESET_LINK=0
LOG_CHATS=0
